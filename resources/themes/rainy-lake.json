{
  "appearance_only": true,
  "format": "desktop-cards-profile",
  "version": 21,
  "name": "Rainy Lake",
  "description": "Warm amber on deep brown",
  "dock": {
    "floating": true,
    "margin": 6,
    "opacity": 0.9,
    "border_radius": 160,
    "spacing": 8,
    "padding": 6,
    "background": "ThemeDefault"

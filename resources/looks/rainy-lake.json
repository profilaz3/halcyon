      "background": "#FBF2E6",
      "primary": "#F0E7DB",
      "secondary": "auto",
      "outline": "auto",
      "outline_width": 1,
      "corners": "Round",
      "gaps": [
        8,
        12
      ]
    },
    "dark": {
      "accent": "#D0AA73",
      "background": "#2F281F",
      "primary": "#393128",
      "secondary": "#2F2731",
      "outline": "auto",
      "outline_width": 1,
      "corners": "Round",
      "gaps": [
        8,
        12
      ]

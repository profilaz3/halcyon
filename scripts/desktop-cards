#!/usr/bin/env python3
"""Control Halcyon: its widgets, Settings window, focus timer and wallpapers.

Installed as `halcyon-ctl` beside the `halcyon` program (see packaging/README.md).
"""
import argparse
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.request

USER_DIR = Path.home()
# The install prefix (`/usr` or `~/.local`): this script lives in `<prefix>/bin`.
PREFIX = Path(__file__).resolve().parent.parent
LEGACY_BINARY = USER_DIR / '.local/bin/cosmic-desktop-cards'
BINARY = PREFIX / 'bin/halcyon' if (PREFIX / 'bin/halcyon').exists() else LEGACY_BINARY
CONFIG_ROOT = Path(os.environ.get('XDG_CONFIG_HOME') or USER_DIR / '.config')
CONFIG = CONFIG_ROOT / 'halcyon'
CONFIG_FILE = Path(os.environ.get('DESKTOP_CARDS_CONFIG', CONFIG / 'config.json'))
BACKGROUND = CONFIG_ROOT / 'cosmic/com.system76.CosmicBackground/v1/all'
CUSTOM = CONFIG_ROOT / 'cosmic/com.system76.CosmicSettings.Wallpaper/v1/custom-images'
# Built-in wallpapers come with Halcyon; an install from before the rename
# copied them to Pictures/Desktop Cards.
INSTALLED_WALLPAPERS = PREFIX / 'share/backgrounds/halcyon'
LEGACY_WALLPAPERS = USER_DIR / 'Pictures/Desktop Cards'
WALLPAPERS = INSTALLED_WALLPAPERS if INSTALLED_WALLPAPERS.is_dir() else LEGACY_WALLPAPERS
THEMES = {'lavender': 'Quiet lavender', 'amber': 'Warm amber', 'teal': 'Night teal',
          'ocean': 'Ocean blue', 'rose': 'Rose', 'graphite': 'Graphite'}
SERVICE = 'halcyon.service'
WIDGETS = {'calendar': 'Calendar — today and meeting links', 'projects': 'Projects — branches and servers',
           'devbox': 'System monitor — CPU, memory, disk, network and GPU', 'weather': 'Weather — current conditions and forecast',
           'clock': 'Clock — time and date above the wallpaper',
           'glance': 'Daily overview — clock, weather and agenda together',
           'music': 'Music — now playing and playback controls',
           'notes': 'Notes — a note on the desktop',
           'focus': 'Focus timer — work and break sessions'}
FOCUS_ACTIONS = ('start', 'pause', 'toggle', 'reset', 'skip')

def atomic(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    name = None
    try:
        with tempfile.NamedTemporaryFile(mode='wb', dir=path.parent, delete=False) as file:
            name = file.name
            file.write(value.encode('utf-8') if isinstance(value, str) else value)
            file.flush()
            os.fsync(file.fileno())
        os.replace(name, path)
    finally:
        if name is not None:
            Path(name).unlink(missing_ok=True)

def config():
    try:
        data = json.loads(CONFIG_FILE.read_text())
    except FileNotFoundError:
        return {'theme': 'lavender', 'location': None}
    except ValueError as error:
        raise RuntimeError('Settings contain invalid JSON. Existing settings were preserved.') from error
    if not isinstance(data, dict):
        raise RuntimeError('Settings must be a JSON object. Existing settings were preserved.')
    return data

@contextmanager
def config_lock():
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    # Shared with Rust: keep this inode stable while config.json is replaced.
    descriptor = os.open(str(CONFIG_FILE) + '.lock', os.O_CREAT | os.O_RDWR, 0o600)
    with os.fdopen(descriptor, 'r+') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield

def edit_config(change):
    if 'DESKTOP_CARDS_CONFIG' not in os.environ:
        helper('--migrate-config', failure='Could not migrate existing settings.')
    with config_lock():
        data = config()
        design = (CONFIG_FILE.with_name('design-v1.json') if CONFIG_FILE.name == 'config.json'
                  else Path(str(CONFIG_FILE) + '.design-v1.json'))
        managed = os.path.lexists(design) or 'widget_design_version' in data
        if not managed:
            change(data)
            atomic(CONFIG_FILE, json.dumps(data, indent=2, allow_nan=False) + '\n')
            return data
    # The native owner locks and checks the request. Never hold Python's lock
    # while waiting for the child, and never fall back to the frozen file.
    result = subprocess.run([str(BINARY), '--read-widget-config'], text=True, capture_output=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or 'Could not read widget design.')
    before = json.loads(result.stdout)
    data = json.loads(result.stdout)
    change(data)
    result = subprocess.run([str(BINARY), '--edit-widget-config'],
                            input=json.dumps({'before': before, 'after': data}, allow_nan=False),
                            text=True, capture_output=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or 'Could not update widget design.')
    return data

def wallpaper_file(name):
    """A built-in wallpaper's file: `<name>.jpg`, or the old `<name>-4k.png`."""
    if WALLPAPERS == INSTALLED_WALLPAPERS:
        return WALLPAPERS / f'{name}.jpg'
    return WALLPAPERS / f'{name}-4k.png'

def bundled_wallpaper(name):
    """The built-in wallpaper; they come with Halcyon and aren't copied anywhere."""
    path = wallpaper_file(name)
    if not path.is_file():
        raise RuntimeError('The built-in wallpapers are missing. Reinstall Halcyon to restore them.')
    return path

def install_bundled_wallpapers():
    missing = [name for name in THEMES if not wallpaper_file(name).is_file()]
    if missing:
        raise RuntimeError('The built-in wallpapers are missing. Reinstall Halcyon to restore them.')
    print(f'The built-in wallpapers are installed in {WALLPAPERS}')

def helper(*args, failure):
    result = subprocess.run([str(BINARY), *args],
                            text=True, capture_output=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or failure)

def apply_palette_links(name, *, wallpaper, colors):
    """One store change: the shared background and/or the COSMIC accents."""
    if 'DESKTOP_CARDS_CONFIG' in os.environ:
        raise RuntimeError('Desktop changes are disabled in an isolated preview.')
    if name not in THEMES:
        raise RuntimeError('Unknown Halcyon palette.')
    flags = ['--wallpaper'] * wallpaper + ['--colors'] * colors
    if flags:
        helper('--apply-palette-links', name, *flags, failure='Could not match the palette.')

def apply_theme(name):
    if name not in THEMES:
        raise RuntimeError('Unknown Halcyon palette.')
    if 'DESKTOP_CARDS_CONFIG' not in os.environ:
        # Rust captures the pre-change desktop and commits preferences and
        # native settings together. Never hold config_lock across this call.
        helper('--select-palette', name, failure='Could not apply the palette.')
    else:
        # An explicitly isolated preview edits only its alternate app file.
        def change(data):
            appearance = data.setdefault('appearance', {})
            if not isinstance(appearance, dict):
                raise RuntimeError('Appearance settings must be a JSON object.')
            for key in ('match_wallpaper', 'match_cosmic_colors'):
                if key in appearance and not isinstance(appearance[key], bool):
                    raise RuntimeError('Color matching settings must be true or false.')
            data['theme'] = name
            if appearance.get('color_source') == 'desktop':
                appearance['color_source'] = 'custom'
            appearance.pop('accent', None)
        edit_config(change)
    print(THEMES[name])

def apply_cosmic_colors(name):
    if 'DESKTOP_CARDS_CONFIG' in os.environ:
        raise RuntimeError('COSMIC color changes are disabled in an isolated preview.')
    if name not in THEMES:
        raise RuntimeError('Unknown Halcyon palette.')
    helper('--apply-cosmic-colors', name, failure='Could not apply COSMIC accent colors.')

def set_cosmic_colors(enabled):
    if not isinstance(enabled, bool):
        raise RuntimeError('COSMIC color matching must be on or off.')
    if 'DESKTOP_CARDS_CONFIG' not in os.environ:
        helper('--set-cosmic-colors', 'on' if enabled else 'off', failure='Could not change COSMIC color matching.')
    else:
        def change(data):
            appearance = data.setdefault('appearance', {})
            if not isinstance(appearance, dict):
                raise RuntimeError('Appearance settings must be a JSON object.')
            appearance['match_cosmic_colors'] = enabled
        edit_config(change)
    print('COSMIC accent matching ' + ('on' if enabled else 'off'))

def service(action):
    actions = {'start': ['enable', '--now'], 'stop': ['disable', '--now']}
    subprocess.run(['systemctl', '--user', *actions.get(action, [action]), SERVICE], check=True)

def dialog(*args):
    result = subprocess.run(['zenity', *args], text=True, capture_output=True)
    return result.stdout.strip() if result.returncode == 0 else None

def city_results(response):
    raw = response.read(64 * 1024 + 1)
    if len(raw) > 64 * 1024:
        raise RuntimeError('City search response is too large.')
    payload = json.loads(raw)
    if not isinstance(payload, dict) or not isinstance(payload.get('results', []), list):
        raise RuntimeError('Could not read city search results.')
    def valid(place):
        if not isinstance(place, dict):
            return False
        if any(not isinstance(place.get(key, ''), str) or len(place.get(key, '').encode()) > 256
               for key in ('name', 'admin1', 'country', 'timezone')) or not place.get('name', '').strip():
            return False
        return all(isinstance(place.get(key), (int, float)) and not isinstance(place[key], bool)
                   and -bound <= place[key] <= bound for key, bound in (('latitude', 90), ('longitude', 180)))
    return [place for place in payload.get('results', []) if valid(place)][:8]

def set_weather(query, interactive=False):
    if len(query) > 256:
        raise RuntimeError('City name is too long.')
    url = 'https://geocoding-api.open-meteo.com/v1/search?' + urllib.parse.urlencode(
        {'name': query, 'count': 8, 'language': 'en', 'format': 'json'})
    with urllib.request.urlopen(url, timeout=20) as response:
        results = city_results(response)
    if not results:
        raise RuntimeError('No matching city found. Try a nearby town or a different spelling.')
    if len(results) > 1:
        if not interactive:
            print(json.dumps([{'name': v['name'], 'region': v.get('admin1'), 'country': v.get('country'),
                               'latitude': v['latitude'], 'longitude': v['longitude']} for v in results], indent=2))
            print('Several places match. Run halcyon-ctl weather-picker to choose one.', file=sys.stderr)
            return
        entries = []
        for i, place in enumerate(results):
            entries.extend([str(i), place['name'], place.get('admin1', ''), place.get('country', '')])
        choice = dialog('--list', '--title=Choose your city', '--width=620', '--height=390',
                        '--column=ID', '--column=City', '--column=Region', '--column=Country',
                        '--hide-column=1', '--print-column=1', *entries)
        if choice is None:
            return
        selected = results[int(choice)]
    else:
        selected = results[0]
    location = {key: selected[key] for key in ('name', 'latitude', 'longitude')}
    if isinstance(selected.get('timezone'), str):
        location['timezone'] = selected['timezone']
    edit_config(lambda data: data.update(location=location))
    print('Weather set to ' + selected['name'])

def weather_picker():
    settings('weather')


def desktop_command(payload):
    folder = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')) / 'halcyon'
    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
    atomic(folder / 'command.json', json.dumps(payload))

def open_panel(widget='open', *, toggle=False):
    desktop_command({'action': 'toggle' if toggle else widget if widget in ('close', 'rail') else 'open', 'widget': widget})

def focus(action):
    """Start, pause, toggle, reset or skip the Focus timer (for keyboard shortcuts)."""
    desktop_command({'action': 'focus', 'do': action})

def settings(page=''):
    # The native entry point owns the window and forwards requests, including
    # direct binary/desktop launches, and leaves the widget service's cgroup.
    subprocess.run([str(BINARY), '--settings', page], check=True)


def restore_background():
    saved = CONFIG / 'original-background.ron'
    if not saved.exists():
        raise RuntimeError('No previous wallpaper backup exists.')
    # Written through the desktop store: validated, journaled, conflict-checked.
    helper('--restore-background', str(saved), failure='Could not restore the previous wallpaper.')

def restore_wallpaper():
    """Restore only the background, keeping widgets and login startup as they are."""
    restore_background()
    print('Previous wallpaper restored.')

def restore():
    # Keep the original command's stop-and-disable behavior for existing callers.
    restore_background()
    service('stop')
    print('Previous wallpaper restored; widgets hidden.')

# Every page the native Settings window accepts (`Page::key` in src/settings.rs), plus the old
# `layout` alias for Widgets.
SETTINGS_PAGES = ('adaptive', 'builder', 'moments', 'overview', 'pending', 'themes', 'presets', 'schedules', 'widget-style', 'system-monitor', 'daily-overview', 'focus-timer', 'app-settings', 'appearance', 'widgets', 'layout', 'glance', 'calendar', 'weather', 'devbox', 'clock',
                  'projects', 'music', 'notes', 'focus', 'general', 'desktop', 'desktop-dock',
                  'desktop-appearance', 'desktop-wallpaper', 'desktop-icons', 'desktop-profiles',
                  'desktop-windows', 'desktop-workspaces', 'desktop-motion', 'desktop-window-rules',
                  'desktop-shortcuts', 'desktop-automation')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command')
    sub.add_parser('theme').add_argument('name', choices=THEMES)
    sub.add_parser('cosmic-colors').add_argument('state', choices=['on', 'off'])
    sub.add_parser('weather').add_argument('city')
    sub.add_parser('panel').add_argument('widget', choices=[*WIDGETS, 'open', 'close', 'rail'], nargs='?', default='open')
    sub.add_parser('toggle').add_argument('widget', choices=WIDGETS)
    sub.add_parser('focus').add_argument('action', choices=FOCUS_ACTIONS)
    sub.add_parser('settings').add_argument('--page', choices=SETTINGS_PAGES, default='')
    for key in ('weather-picker', 'start', 'stop', 'restart', 'status', 'restore', 'restore-wallpaper', 'wallpapers-install'):
        sub.add_parser(key)
    args = parser.parse_args()
    if args.command == 'theme':
        apply_theme(args.name)
    elif args.command == 'cosmic-colors':
        set_cosmic_colors(args.state == 'on')
    elif args.command == 'weather':
        set_weather(args.city)
    elif args.command == 'weather-picker':
        weather_picker()
    elif args.command == 'panel':
        open_panel(args.widget)
    elif args.command == 'toggle':
        open_panel(args.widget, toggle=True)
    elif args.command == 'focus':
        focus(args.action)
    elif args.command in ('start', 'stop', 'restart', 'status'):
        service(args.command)
    elif args.command == 'restore':
        restore()
    elif args.command == 'restore-wallpaper':
        restore_wallpaper()
    elif args.command == 'wallpapers-install':
        install_bundled_wallpapers()
    else:
        settings(getattr(args, 'page', ''))

if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        print(str(exc), file=sys.stderr)
        if len(sys.argv) < 2 or sys.argv[1] in ('settings', 'weather-picker'):
            dialog('--error', '--title=Halcyon', '--text=' + str(exc))
        sys.exit(1)

+/// Panel-colored background that fades towards the desktop.
+#[derive(Debug, Deserialize, Serialize, Clone, Copy, PartialEq)]
+#[serde(default, deny_unknown_fields)]
+pub struct TopEdgeGradient {
+    /// Retain appearance preferences while the effect is disabled.
+    pub enabled: bool,
+    /// Fade extent for a 32-logical-pixel-thick panel. The renderer scales it
+    /// proportionally to the actual panel thickness on every screen edge.
+    pub height: u32,
+    /// Legacy gradient opacity. Rendering follows the panel's background opacity.
+    pub opacity: f32,
+    /// Solid panel RGB when a window is maximized on this output.
+    /// Accepted for compatibility with earlier preferences. Rendering uses
+    /// the panel's background color in both light and dark mode.
+    pub maximized_color: [u8; 3],
+    /// Opacity of the uniform background when a window is maximized.
+    pub maximized_opacity: f32,
+}
+
+impl Default for TopEdgeGradient {
+    fn default() -> Self {
+        Self {
+            enabled: true,
+            height: 96,
+            opacity: 0.4,
+            maximized_color: [0x24, 0x26, 0x2a],
+            maximized_opacity: 1.0,
+        }
+    }
+}
+
+impl TopEdgeGradient {
+    pub fn normalized(self) -> Self {
+        Self {
+            enabled: self.enabled,
+            maximized_color: self.maximized_color,
+            maximized_opacity: if self.maximized_opacity.is_finite() {
+                self.maximized_opacity.clamp(0.0, 1.0)
+            } else {
+                Self::default().maximized_opacity
+            },
+            height: self.height.clamp(16, 512),
+            opacity: if self.opacity.is_finite() {
+                self.opacity.clamp(0.0, 1.0)
+            } else {
+                Self::default().opacity
+            },
+        }
+    }
+}

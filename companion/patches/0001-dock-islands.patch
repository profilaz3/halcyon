+//! Desktop Cards companion extension. Stock panel schemas remain unchanged.
+use crate::iced::elements::CosmicMappedInternal;
+use crate::iced::elements::background::{BackgroundElement, PanelBorder, background_element};
+use crate::space::PanelSpace;
+use cosmic::widget::Id;
+use cosmic_panel_config::PanelAnchor;
+use dock_islands_core::{Layout, Settings};
+use sctk::shell::WaylandSurface;
+use smithay::{desktop::space::SpaceElement, utils::Rectangle};
+use std::{fs, path::PathBuf};
+
+#[derive(Debug, Default)]
+pub struct IslandState {
+    pub settings: Settings,
+    pub material: Option<dock_islands_core::material::Finish>,
+    pub geometry: Layout,
+    pub backgrounds: Vec<BackgroundElement>,
+    pub overflow_sizes: Vec<(smithay::desktop::Window, f64)>,
+    pub error: Option<String>,
+    pub lease: Option<Lease>,
+    pub handles: Vec<(Handle, Span, Span)>,
+    pub expiry: Option<calloop::RegistrationToken>,
+    pub last_major: i32,
+    pub touch: Option<(i32, (f64, f64))>,
+    background_stamp: Option<BackgroundStamp>,
+}
+
+#[derive(Debug, PartialEq)]
+struct BackgroundStamp {
+    layout: Layout,
+    dimensions: (i32, i32),
+    anchor_gap: i32,
+    scale: f64,
+    radius: u32,
+    color: [f32; 4],
+    frosting: bool,
+    material: Option<dock_islands_core::material::Finish>,
+    lease: Option<(u64, u64, bool)>,
+}
+
+pub fn settings_path(panel: &str) -> Result<PathBuf, String> {
+    if !matches!(panel, "Dock" | "Panel") {
+        return Err("Unsupported panel entry".into());
+    }
+    let config = std::env::var_os("XDG_CONFIG_HOME")
+        .map(PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").map(|p| PathBuf::from(p).join(".config")))
+        .ok_or("No configuration directory")?;
+    Ok(config.join("cosmic").join(dock_islands_core::NAMESPACE).join("v1").join(panel))
+}
+pub fn load_settings(panel: &str) -> Result<Settings, String> {
+    let path = settings_path(panel)?;
+    let data = match fs::read(&path) {
+        Ok(data) if data.len() <= dock_islands_core::MAX_WIRE_BYTES => data,
+        Ok(_) => return Err("Island settings are too large".into()),
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(Settings::default()),
+        Err(e) => return Err(e.to_string()),
+    };
+    let settings: Settings = ron::de::from_bytes(&data).map_err(|e| e.to_string())?;
+    settings.validate()?;
+    Ok(settings)
+}
+impl IslandState {
+    pub fn load(panel: &str) -> Self {
+        let material = load_material(panel);
+        match load_settings(panel) {
+            Ok(settings) => Self { settings, material, ..Self::default() },
+            Err(error) => Self { error: Some(error), material, ..Self::default() },
+        }
+    }
+}
+impl PanelSpace {
+    pub(crate) fn layout_island_backgrounds(
+        &mut self,
+        width: i32,
+        height: i32,
+        _thickness: i32,
+    ) -> anyhow::Result<()> {
+        // Native theme owns hue, opacity and its frosted alpha mapping.
+        let color = self.bg_color();
+        let frosting = self.blur_surface.is_some() && self.material_blur();
+        let stamp = BackgroundStamp {
+            layout: self.islands.geometry.clone(),
+            dimensions: (width, height),
+            anchor_gap: self.anchor_gap,
+            scale: self.scale,
+            radius: self.border_radius(),
+            color,
+            frosting,
+            material: self.islands.material,
+            lease: self
+                .islands
+                .lease
+                .as_ref()
+                .map(|l| (l.token, l.revision, l.drag.as_ref().is_some_and(|d| d.started))),
+        };
+        // Iced elements request their first frame on creation. Keep unchanged
+        // backgrounds, otherwise a relayout would create a repaint loop.
+        if self.islands.background_stamp.as_ref() == Some(&stamp)
+            && !self.is_background_dirty
+            && !self.transitioning
+        {
+            return Ok(());
+        }
+        if let Some(bg) = self.background_element.take() {
+            self.space.unmap_elem(&CosmicMappedInternal::Background(bg));
+        }
+        for bg in self.islands.backgrounds.drain(..) {
+            self.space.unmap_elem(&CosmicMappedInternal::Background(bg));
+        }
+        let Some((_, output, _)) = self.output.as_ref() else {
+            anyhow::bail!("output missing");
+        };
+        let Some(region) = self.input_region.as_ref() else {
+            anyhow::bail!("input region missing");
+        };
+        let Some(layer) = self.layer.as_ref() else {
+            anyhow::bail!("layer missing");
+        };
+        region.subtract(0, 0, i32::MAX, i32::MAX);
+        self.islands.handles.clear();
+        let horizontal = self.config.is_horizontal();
+        let thickness =
+            (if horizontal { height } else { width } - self.config.margin as i32).max(1);
+        let cross = match self.config.anchor {
+            PanelAnchor::Top | PanelAnchor::Left => self.config.margin as i32 + self.anchor_gap,
+            _ => -self.anchor_gap,
+        };
+
+        // A union of rounded rectangles clips each island independently.
+        // Keep the surface-wide corner radius zero: applying it to a thin
+        // region rectangle triggers radius_too_large on reviewed compositors.
+        // Never reuse the input region: it also contains reveal/drag handles.
+        let blur_region = if frosting {
+            self.compositor_state.as_ref().and_then(|c| sctk::compositor::Region::new(c).ok())
+        } else {
+            None
+        };
+        if let Some(corners) = &self.corner_radius_wlr {
+            corners.set_radius(0, 0, 0, 0);
+            corners.set_padding(0, 0, 0, 0);
+        }
+        for (i, span) in self.islands.geometry.spans.iter().enumerate() {
+            let Some(span) = span else {
+                continue;
+            };
+            let major = span.start.round() as i32;
+            let length = (span.end().round() as i32 - major).max(1);
+            let (x, y, w, h) = if horizontal {
+                (major, cross, length, thickness)
+            } else {
+                (cross, major, thickness, length)
+            };
+            let radius = (self.border_radius() as f32).min(w as f32 / 2.).min(h as f32 / 2.);
+            let dragging =
+                self.islands.lease.as_ref().and_then(|l| l.drag.as_ref()).is_some_and(|d| {
+                    d.started
+                        && (d.handle == Handle::Group
+                            || d.handle == Handle::Island(Section::ALL[i]))
+                });
+            let bg = background_element(
+                Id::new(format!("island-{i}")),
+                w,
+                h,
+                [radius; 4],
+                self.shared.loop_handle.clone(),
+                self.colors.theme.clone(),
+                self.space.id(),
+                [x as f32, y as f32],
+                color,
+                self.scale,
+                if dragging { PanelBorder::Accent } else { PanelBorder::Full },
+                if dragging { 2. } else { self.config.border_width },
+                self.islands.material,
+            );
+            bg.output_enter(output, Rectangle::default());
+            self.space.map_element(CosmicMappedInternal::Background(bg.clone()), (x, y), false);
+            self.islands.backgrounds.push(bg);
+            // Rounded input masks follow visible pixels. Add a small edge
+            // reveal strip while hidden; gaps never become input surfaces.
+            for [rx, ry, rw, rh] in dock_islands_core::rounded_region(x, y, w, h, radius as f64) {
+                region.add(rx, ry, rw, rh);
+                if let Some(blur_region) = &blur_region {
+                    blur_region.add(rx, ry, rw, rh);
+                }
+            }
+            if self.config.autohide_enabled() && self.anchor_gap != 0 {
+                let reveal = self.config.get_hide_handle().max(1) as i32;
+                match self.config.anchor {
+                    PanelAnchor::Top => region.add(major, 0, length, reveal.min(height)),
+                    PanelAnchor::Bottom => {
+                        region.add(major, (height - reveal).max(0), length, reveal.min(height))
+                    },
+                    PanelAnchor::Left => region.add(0, major, reveal.min(width), length),
+                    PanelAnchor::Right => {
+                        region.add((width - reveal).max(0), major, reveal.min(width), length)
+                    },
+                }
+            }
+        }
+        if let Some(lease) = &self.islands.lease {
+            let extra = self.arrange_extra();
+            let band = if matches!(self.config.anchor, PanelAnchor::Bottom | PanelAnchor::Right) {
+                cross
+            } else {
+                cross + thickness - extra
+            };
+            let together = self.islands.settings.placement == Placement::Together;
+            let mut handles: Vec<_> = self
+                .islands
+                .geometry
+                .spans
+                .iter()
+                .enumerate()
+                .filter_map(|(i, s)| {
+                    s.map(|s| {
+                        (
+                            Handle::Island(Section::ALL[i]),
+                            s,
+                            Span {
+                                start: band as f64 + if together { HANDLE } else { 0. },
+                                length: HANDLE,
+                            },
+                            format!(":: {}", i + 1),
+                        )
+                    })
+                })
+                .collect();
+            if together && self.islands.geometry.spans.iter().any(Option::is_some) {
+                let group = self.islands.geometry.group;
+                let length = group.length.min(100.);
+                handles.push((
+                    Handle::Group,
+                    Span { start: group.center() - length / 2., length },
+                    Span { start: band as f64, length: HANDLE },
+                    "Move group".into(),
+                ));
+            }
+            for (handle, major, cross, mut label) in handles {
+                if horizontal
+                    && lease.drag.as_ref().is_some_and(|d| d.started && d.handle == handle)
+                {
+                    let span =
+                        if handle == Handle::Group { self.islands.geometry.group } else { major };
+                    let bounds = self.islands.geometry.bounds;
+                    let hint = if (span.start - bounds.start).abs() < 1. {
+                        "Start"
+                    } else if (span.end() - bounds.end()).abs() < 1. {
+                        "End"
+                    } else if (span.center() - bounds.center()).abs() < 1. {
+                        "Center"
+                    } else {
+                        ""
+                    };
+                    label = format!("{hint} {} px", self.islands.geometry.gap.round() as u32);
+                }
+                let (x, y, w, h) = if horizontal {
+                    (major.start, cross.start, major.length, cross.length)
+                } else {
+                    (cross.start, major.start, cross.length, major.length)
+                };
+                let label = if !horizontal {
+                    if handle == Handle::Group { "::".into() } else { label.replace(":: ", "") }
+                } else {
+                    label
+                };
+                let bg = crate::iced::elements::background::island_handle(
+                    Id::new(format!("island-handle-{handle:?}")),
+                    w.round() as i32,
+                    h.round() as i32,
+                    [x as f32, y as f32],
+                    label,
+                    handle == lease.selected,
+                    self.shared.loop_handle.clone(),
+                    self.colors.theme.clone(),
+                    self.space.id(),
+                    self.scale,
+                );
+                bg.output_enter(output, Rectangle::default());
+                self.space.map_element(
+                    CosmicMappedInternal::Background(bg.clone()),
+                    (x as i32, y as i32),
+                    true,
+                );
+                self.islands.backgrounds.insert(0, bg);
+                region.add(x.round() as i32, y.round() as i32, w.round() as i32, h.round() as i32);
+                self.islands.handles.push((handle, major, cross));
+            }
+        }
+        if let Some(blur) = &self.blur_surface {
+            blur.set_blur_region(blur_region.as_ref().map(|r| r.wl_region()));
+        }
+        layer.wl_surface().set_input_region(Some(region.wl_region()));
+        self.is_background_dirty = false;
+        self.islands.background_stamp = Some(stamp);
+        self.transitioning = false;
+        Ok(())
+    }
+}
+
+use dock_islands_core::{
+    Capabilities, Drag, HANDLE, Handle, MAX_WIRE_BYTES, Placement, Request, Response, Section, Span,
+};
+use sctk::shell::wlr_layer::KeyboardInteractivity;
+use std::io::{BufRead, BufReader, Read, Write};
+use std::os::unix::{
+    fs::{FileTypeExt, MetadataExt, PermissionsExt},
+    net::{UnixListener, UnixStream},
+};
+use std::sync::{
+    Arc,
+    atomic::{AtomicU64, AtomicUsize, Ordering},
+    mpsc,
+};
+use std::time::Duration;
+
+#[derive(Debug)]
+pub struct Lease {
+    pub connection: u64,
+    pub token: u64,
+    pub revision: u64,
+    pub selected: Handle,
+    pub drag: Option<Drag>,
+    pub output: String,
+}
+#[derive(Debug)]
+pub enum Event {
+    Command { connection: u64, request: Request, reply: mpsc::SyncSender<Response> },
+    Disconnected(u64),
+    Reload,
+    Expire(u64, u64),
+}
+
+pub fn serve(tx: calloop::channel::Sender<crate::PanelCalloopMsg>) -> anyhow::Result<()> {
+    let runtime = PathBuf::from(
+        std::env::var_os("XDG_RUNTIME_DIR")
+            .ok_or_else(|| anyhow::anyhow!("No runtime directory"))?,
+    );
+    let meta = runtime.metadata()?;
+    if meta.uid() != rustix_uid() || meta.permissions().mode() & 0o077 != 0 {
+        anyhow::bail!("Runtime directory is not private");
+    }
+    let path = runtime.join("desktop-cards-islands-v1.sock");
+    if let Ok(meta) = fs::symlink_metadata(&path) {
+        if !meta.file_type().is_socket() || meta.uid() != rustix_uid() {
+            anyhow::bail!("Unsafe existing socket");
+        }
+        if UnixStream::connect(&path).is_ok() {
+            anyhow::bail!("An islands panel is already running");
+        }
+        fs::remove_file(&path)?;
+    }
+    let listener = UnixListener::bind(&path)?;
+    fs::set_permissions(&path, fs::Permissions::from_mode(0o600))?;
+    // Filesystem notification, not a polling worker. Watch the existing
+    // config tree so creating the sidecar namespace is also detected.
+    let watch_tx = tx.clone();
+    use notify::Watcher;
+    let mut watcher = notify::recommended_watcher(move |event: notify::Result<notify::Event>| {
+        if let Ok(e) = event
+            && matches!(
+                e.kind,
+                notify::EventKind::Create(_)
+                    | notify::EventKind::Modify(_)
+                    | notify::EventKind::Remove(_)
+            )
+            && e.paths.iter().any(|p| {
+                p.components().any(|part| {
+                    part.as_os_str() == dock_islands_core::NAMESPACE
+                        || part.as_os_str() == dock_islands_core::material::NAMESPACE
+                })
+            })
+        {
+            let _ = watch_tx.send(crate::PanelCalloopMsg::Islands(Event::Reload));
+        }
+    })?;
+    if let Ok(path) = settings_path("Dock") {
+        if let Some(root) = path.parent().and_then(|p| p.parent()).and_then(|p| p.parent()) {
+            if root.is_dir() {
+                watcher.watch(root, notify::RecursiveMode::Recursive)?;
+            }
+        }
+    }
+    std::thread::spawn(move || {
+        let _watcher = watcher;
+        let next = AtomicU64::new(1);
+        let connections = Arc::new(AtomicUsize::new(0));
+        for stream in listener.incoming().flatten() {
+            if connections.fetch_add(1, Ordering::SeqCst) >= 4 {
+                connections.fetch_sub(1, Ordering::SeqCst);
+                continue;
+            }
+            let id = next.fetch_add(1, Ordering::Relaxed);
+            let tx = tx.clone();
+            let connections = connections.clone();
+            std::thread::spawn(move || {
+                connection(stream, id, &tx);
+                let _ = tx.send(crate::PanelCalloopMsg::Islands(Event::Disconnected(id)));
+                connections.fetch_sub(1, Ordering::SeqCst);
+            });
+        }
+    });
+    Ok(())
+}
+fn rustix_uid() -> u32 {
+    // A bound runtime socket is already private. Compare ownership without
+    // adding a toolkit-specific dependency to the wire crate.
+    unsafe { libc::geteuid() }
+}
+fn connection(stream: UnixStream, id: u64, tx: &calloop::channel::Sender<crate::PanelCalloopMsg>) {
+    let Ok(writer) = stream.try_clone() else {
+        return;
+    };
+    let mut writer = writer;
+    let _ = writer.set_write_timeout(Some(Duration::from_secs(2)));
+    let mut reader = BufReader::new(stream);
+    loop {
+        let mut bytes = Vec::new();
+        match reader.by_ref().take((MAX_WIRE_BYTES + 1) as u64).read_until(b'\n', &mut bytes) {
+            Ok(0) | Err(_) => break,
+            Ok(_) if bytes.len() > MAX_WIRE_BYTES || !bytes.ends_with(b"\n") => break,
+            _ => {},
+        }
+        let response = match serde_json::from_slice::<Request>(&bytes) {
+            Ok(request) => {
+                let (reply, result) = mpsc::sync_channel(1);
+                if tx
+                    .send(crate::PanelCalloopMsg::Islands(Event::Command {
+                        connection: id,
+                        request,
+                        reply,
+                    }))
+                    .is_err()
+                {
+                    break;
+                }
+                result.recv_timeout(Duration::from_secs(2)).unwrap_or_else(|_| {
+                    Response::Error("Panel did not acknowledge the request".into())
+                })
+            },
+            Err(_) => Response::Error("Invalid islands request".into()),
+        };
+        let Ok(mut data) = serde_json::to_vec(&response) else {
+            break;
+        };
+        data.push(b'\n');
+        if writer.write_all(&data).is_err() {
+            break;
+        }
+    }
+}
+
+pub fn handle_event(state: &mut crate::xdg_shell_wrapper::shared_state::GlobalState, event: Event) {
+    match event {
+        Event::Command { connection, request, reply } => {
+            let _ = reply.send(command(state, connection, request));
+        },
+        Event::Disconnected(connection) => {
+            for panel in &mut state.space.space_list {
+                if panel.islands.lease.as_ref().is_some_and(|l| l.connection == connection) {
+                    panel.end_island_lease();
+                }
+            }
+        },
+        Event::Reload => {
+            reconcile_outputs(state);
+            for panel in &mut state.space.space_list {
+                let material = load_material(&panel.config.name);
+                if material != panel.islands.material {
+                    panel.islands.material = material;
+                    panel.is_background_dirty = true;
+                    panel.is_dirty = true;
+                    panel.needs_layout = true;
+                }
+                if let Ok(settings) = load_settings(&panel.config.name) {
+                    if panel.islands.lease.is_none() && settings != panel.islands.settings {
+                        panel.set_islands(settings);
+                    }
+                }
+            }
+        },
+        Event::Expire(token, revision) => {
+            for panel in &mut state.space.space_list {
+                if panel
+                    .islands
+                    .lease
+                    .as_ref()
+                    .is_some_and(|l| l.token == token && l.revision == revision)
+                {
+                    panel.end_island_lease();
+                }
+            }
+        },
+    }
+}
+// A configured connector can be temporarily absent while its dock is shown
+// on the fallback output. Only that configured name may select the fallback.
+fn panel_index(
+    state: &crate::xdg_shell_wrapper::shared_state::GlobalState,
+    panel: &str,
+    output: &str,
+) -> Option<usize> {
+    let fallback = !output.is_empty()
+        && state.space.config.config_list.iter().any(|c| {
+            c.name == panel
+                && matches!(&c.output, cosmic_panel_config::CosmicPanelOuput::Name(name) if name == output)
+        })
+        && !state.space.outputs.iter().any(|o| o.1.name() == output);
+    state.space.space_list.iter().position(|p| {
+        p.config.name == panel
+            && (output.is_empty()
+                || fallback
+                || p.output.as_ref().is_some_and(|o| o.2.name.as_deref() == Some(output)))
+    })
+}
+
+fn command(
+    state: &mut crate::xdg_shell_wrapper::shared_state::GlobalState,
+    connection: u64,
+    request: Request,
+) -> Response {
+    match request {
+        Request::MaterialSupport => Response::MaterialSupport { version: 1 },
+        Request::Capabilities => Response::Capabilities(Capabilities {
+            // Capability, not the user's current frosting preference. No active
+            // surfaces means no claim yet; the app can ask again after startup.
+            rounded_blur: !state.space.space_list.is_empty()
+                && state.space.space_list.iter().all(|p| p.blur_surface.is_some()),
+            ..Capabilities::default()
+        }),
+        Request::Inspect { panel, output } => {
+            match panel_index(state, &panel, &output).map(|i| &state.space.space_list[i]) {
+                Some(p) => Response::Draft {
+                    token: 0,
+                    revision: 0,
+                    settings: p.islands.settings.clone(),
+                    layout: p.islands.geometry.clone(),
+                    view: p.island_view(),
+                },
+                None => Response::Error("This panel is not active on the selected display".into()),
+            }
+        },
+        Request::Begin { panel, output, base, draft } => {
+            if let Err(e) = draft.validate().and_then(|_| base.validate()) {
+                return Response::Error(e);
+            }
+            if !draft.enabled {
+                return Response::Error("Enable Islands to arrange".into());
+            }
+            if state.space.space_list.iter().any(|p| p.islands.lease.is_some()) {
+                return Response::Error("Another arrangement is open".into());
+            }
+            match load_settings(&panel) {
+                Ok(current) if current == base => {},
+                Ok(_) => {
+                    return Response::Error("Island settings changed outside this editor".into());
+                },
+                Err(e) => return Response::Error(e),
+            }
+            let Some(index) = panel_index(state, &panel, &output) else {
+                return Response::Error("This panel is not visible on the selected display".into());
+            };
+            let p = &mut state.space.space_list[index];
+            static TOKENS: AtomicU64 = AtomicU64::new(1);
+            let token = TOKENS.fetch_add(1, Ordering::Relaxed);
+            let output = p.output.as_ref().and_then(|o| o.2.name.clone()).unwrap_or_default();
+            p.islands.lease = Some(Lease {
+                connection,
+                token,
+                revision: 1,
+                selected: Handle::Island(Section::Center),
+                drag: None,
+                output,
+            });
+            p.set_islands(draft);
+            if let Some(layer) = &p.layer {
+                layer.set_keyboard_interactivity(KeyboardInteractivity::OnDemand);
+                layer.commit();
+            }
+            p.expire_lease();
+            p.island_response()
+        },
+        Request::Activate { panel, expected } => {
+            if let Err(e) = expected.validate() {
+                return Response::Error(e);
+            }
+            match load_settings(&panel) {
+                Ok(settings) if settings == expected => {
+                    // Reconcile both enabling a previously invisible bar and
+                    // disabling its fallback before acknowledging live state.
+                    reconcile_outputs(state);
+                    let mut found = false;
+                    for p in state.space.space_list.iter_mut().filter(|p| p.config.name == panel) {
+                        p.end_island_lease();
+                        p.set_islands(settings.clone());
+                        found = true;
+                    }
+                    // A disabled named-output bar is correctly absent when
+                    // its configured monitor is disconnected. That is a
+                    // completed application, not a failed live acknowledgment.
+                    let hidden_by_configuration = !settings.enabled
+                        && state.space.config.config_list.iter().any(|config| {
+                            config.name == panel
+                                && matches!(&config.output,
+                                cosmic_panel_config::CosmicPanelOuput::Name(name)
+                                if !state.space.outputs.iter().any(|o| o.1.name() == *name))
+                        });
+                    if found || hidden_by_configuration {
+                        Response::Applied { settings }
+                    } else {
+                        Response::Error("Settings saved, but no matching panel is active".into())
+                    }
+                },
+                Ok(_) => Response::Error("Persisted island settings do not match the draft".into()),
+                Err(e) => Response::Error(e),
+            }
+        },
+        other => {
+            let token = match &other {
+                Request::Update { token, .. }
+                | Request::Select { token, .. }
+                | Request::Read { token }
+                | Request::Done { token }
+                | Request::Cancel { token } => *token,
+                _ => unreachable!(),
+            };
+            let Some(p) = state.space.space_list.iter_mut().find(|p| {
+                p.islands
+                    .lease
+                    .as_ref()
+                    .is_some_and(|l| l.connection == connection && l.token == token)
+            }) else {
+                return Response::Error("The arrangement session ended".into());
+            };
+            match other {
+                Request::Update { revision, draft, .. } => {
+                    if let Err(e) = draft.validate() {
+                        return Response::Error(e);
+                    }
+                    if p.islands.lease.as_ref().unwrap().revision != revision {
+                        return Response::Error(
+                            "The arrangement changed; read its latest revision".into(),
+                        );
+                    }
+                    p.set_islands(draft);
+                    p.bump_island_revision();
+                    p.island_response()
+                },
+                Request::Select { handle, .. } => {
+                    if !p.islands.handles.iter().any(|(h, ..)| *h == handle) {
+                        return Response::Error("This island is empty".into());
+                    }
+                    p.islands.lease.as_mut().unwrap().selected = handle;
+                    p.bump_island_revision();
+                    p.island_response()
+                },
+                Request::Read { .. } => p.island_response(),
+                Request::Done { .. } => {
+                    p.cancel_island_drag();
+                    let result = p.island_response();
+                    p.end_island_lease();
+                    result
+                },
+                Request::Cancel { .. } => {
+                    p.end_island_lease();
+                    Response::Cancelled
+                },
+                _ => unreachable!(),
+            }
+        },
+    }
+}
+impl PanelSpace {
+    pub fn set_islands(&mut self, settings: Settings) {
+        if self.islands.settings.enabled != settings.enabled {
+            self.reset_overflow();
+        }
+        if let Some(lease) = &mut self.islands.lease {
+            if self.islands.settings.placement != settings.placement {
+                lease.drag = None;
+            }
+        }
+        self.islands.settings = settings;
+        self.normalize_island_selection();
+        self.islands.error = None;
+        self.is_dirty = true;
+        self.needs_layout = true;
+        self.is_background_dirty = true;
+    }
+    pub(crate) fn normalize_island_selection(&mut self) {
+        let Some(lease) = &mut self.islands.lease else {
+            return;
+        };
+        let valid = match lease.selected {
+            Handle::Group => {
+                self.islands.settings.placement == Placement::Together
+                    && self.islands.geometry.spans.iter().any(Option::is_some)
+            },
+            Handle::Island(section) => self.islands.geometry.spans[section.index()].is_some(),
+        };
+        if !valid {
+            if let Some(section) = self
+                .islands
+                .settings
+                .layout(&lease.output)
+                .order(self.islands.settings.placement)
+                .iter()
+                .find(|s| self.islands.geometry.spans[s.index()].is_some())
+            {
+                lease.selected = Handle::Island(*section);
+                lease.drag = None;
+            }
+        }
+    }
+    pub fn island_view(&self) -> dock_islands_core::View {
+        let size = self.output.as_ref().and_then(|o| o.2.logical_size).unwrap_or_else(|| {
+            self.output
+                .as_ref()
+                .map(|o| {
+                    o.1.current_mode()
+                        .map(|m| (m.size.w as f64 / self.scale, m.size.h as f64 / self.scale))
+                })
+                .flatten()
+                .map(|(w, h)| (w.round() as i32, h.round() as i32))
+                .unwrap_or((0, 0))
+        });
+        let origin = match self.config.anchor {
+            PanelAnchor::Top => {
+                [(size.0 - self.dimensions.w) as f64 / 2., self.additional_gap as f64]
+            },
+            PanelAnchor::Bottom => [
+                (size.0 - self.dimensions.w) as f64 / 2.,
+                (size.1 - self.dimensions.h - self.additional_gap) as f64,
+            ],
+            PanelAnchor::Left => {
+                [self.additional_gap as f64, (size.1 - self.dimensions.h) as f64 / 2.]
+            },
+            PanelAnchor::Right => [
+                (size.0 - self.dimensions.w - self.additional_gap) as f64,
+                (size.1 - self.dimensions.h) as f64 / 2.,
+            ],
+        };
+        dock_islands_core::View {
+            output: self.output.as_ref().and_then(|o| o.2.name.clone()).unwrap_or_default(),
+            selected: self.islands.lease.as_ref().map(|l| l.selected).filter(|selected| {
+                self.islands.handles.iter().any(|(handle, ..)| handle == selected)
+            }),
+            visible: matches!(
+                self.visibility,
+                crate::xdg_shell_wrapper::space::Visibility::Visible
+            ),
+            popups: self.popups.len() + usize::from(self.overflow_popup.is_some()),
+            overflow: [&self.overflow_left, &self.overflow_center, &self.overflow_right].map(|s| {
+                s.elements()
+                    .filter(|e| matches!(e, crate::iced::elements::PopupMappedInternal::Window(_)))
+                    .count()
+            }),
+            horizontal: self.config.is_horizontal(),
+            origin,
+            scale: self.scale,
+            handles: self.islands.handles.clone(),
+        }
+    }
+    pub fn island_response(&self) -> Response {
+        let Some(lease) = &self.islands.lease else {
+            return Response::Error("No arrangement is open".into());
+        };
+        Response::Draft {
+            token: lease.token,
+            revision: lease.revision,
+            settings: self.islands.settings.clone(),
+            layout: self.islands.geometry.clone(),
+            view: self.island_view(),
+        }
+    }
+    fn expire_lease(&mut self) {
+        if let Some(timer) = self.islands.expiry.take() {
+            self.shared.loop_handle.remove(timer);
+        }
+        if let Some(lease) = &self.islands.lease {
+            let token = lease.token;
+            let revision = lease.revision;
+            self.islands.expiry = self
+                .shared
+                .loop_handle
+                .insert_source(
+                    calloop::timer::Timer::from_duration(Duration::from_secs(900)),
+                    move |_, _, state| {
+                        handle_event(state, Event::Expire(token, revision));
+                        calloop::timer::TimeoutAction::Drop
+                    },
+                )
+                .ok();
+        }
+    }
+    fn bump_island_revision(&mut self) {
+        if let Some(lease) = &mut self.islands.lease {
+            lease.revision = lease.revision.saturating_add(1);
+        }
+        self.expire_lease();
+        self.needs_layout = true;
+        self.is_dirty = true;
+    }
+    pub fn end_island_lease(&mut self) {
+        if self.islands.lease.take().is_none() {
+            return;
+        }
+        self.islands.touch = None;
+        if let Some(timer) = self.islands.expiry.take() {
+            self.shared.loop_handle.remove(timer);
+        }
+        self.set_islands(load_settings(&self.config.name).unwrap_or_default());
+        if let Some(layer) = &self.layer {
+            let k = match self.config.keyboard_interactivity {
+                xdg_shell_wrapper_config::KeyboardInteractivity::None => {
+                    KeyboardInteractivity::None
+                },
+                xdg_shell_wrapper_config::KeyboardInteractivity::OnDemand => {
+                    KeyboardInteractivity::OnDemand
+                },
+                xdg_shell_wrapper_config::KeyboardInteractivity::Exclusive => {
+                    KeyboardInteractivity::Exclusive
+                },
+            };
+            layer.set_keyboard_interactivity(k);
+            layer.commit();
+        }
+        // Resume the existing wait interval, instead of hiding mid-exit.
+        self.start_instant = std::time::Instant::now();
+    }
+    pub fn arrange_extra(&self) -> i32 {
+        if self.islands.lease.is_some() {
+            HANDLE as i32
+                * if self.islands.settings.placement == Placement::Together { 2 } else { 1 }
+        } else {
+            0
+        }
+    }
+    pub fn cancel_island_drag(&mut self) {
+        if let Some(drag) = self.islands.lease.as_mut().and_then(|l| l.drag.take()) {
+            drag.cancel(&mut self.islands.settings);
+            self.bump_island_revision();
+        }
+    }
+    pub fn island_pointer(&mut self, event: &sctk::seat::pointer::PointerEvent) -> bool {
+        use sctk::seat::pointer::{BTN_LEFT, PointerEventKind as K};
+        if self.islands.lease.is_none()
+            || !self.layer.as_ref().is_some_and(|l| l.wl_surface() == &event.surface)
+        {
+            return false;
+        }
+        let (major, cross) = if self.config.is_horizontal() {
+            event.position
+        } else {
+            (event.position.1, event.position.0)
+        };
+        let handle = self
+            .islands
+            .handles
+            .iter()
+            .find(|(_, a, b)| a.contains(major) && b.contains(cross))
+            .map(|(h, ..)| *h);
+        match event.kind {
+            K::Enter { .. } | K::Leave { .. } => false,
+            K::Press { button: BTN_LEFT, .. } if handle.is_some() => {
+                let handle = handle.unwrap();
+                let drag = Drag::new(&self.islands.settings, &self.islands.geometry, handle, major);
+                let lease = self.islands.lease.as_mut().unwrap();
+                lease.selected = handle;
+                lease.drag = drag;
+                self.bump_island_revision();
+                true
+            },
+            K::Motion { .. } if self.islands.lease.as_ref().unwrap().drag.is_some() => {
+                let lease = self.islands.lease.as_mut().unwrap();
+                if lease.drag.as_mut().unwrap().motion(
+                    &mut self.islands.settings,
+                    &lease.output,
+                    &self.islands.geometry,
+                    major,
+                ) {
+                    self.bump_island_revision();
+                }
+                true
+            },
+            K::Release { button: BTN_LEFT, .. }
+                if self.islands.lease.as_ref().unwrap().drag.is_some() =>
+            {
+                let thickness =
+                    if self.config.is_horizontal() { self.dimensions.h } else { self.dimensions.w }
+                        as f64;
+                if cross < 0. || cross >= thickness || !self.islands.geometry.bounds.contains(major)
+                {
+                    self.cancel_island_drag();
+                } else {
+                    self.islands.lease.as_mut().unwrap().drag = None;
+                    self.bump_island_revision();
+                }
+                true
+            },
+            _ => handle.is_some(),
+        }
+    }
+    pub fn island_key(&mut self, key: u32) -> bool {
+        let Some(lease) = self.islands.lease.as_ref() else {
+            return false;
+        };
+        let handle = lease.selected;
+        let output = lease.output.clone();
+        match key {
+            0xff1b => {
+                if lease.drag.is_some() {
+                    self.cancel_island_drag();
+                } else {
+                    self.end_island_lease();
+                }
+            },
+            0xff09 | 0xfe20 => {
+                let mut handles: Vec<_> = self
+                    .islands
+                    .settings
+                    .layout(&output)
+                    .order(self.islands.settings.placement)
+                    .iter()
+                    .filter(|s| self.islands.geometry.spans[s.index()].is_some())
+                    .map(|s| Handle::Island(*s))
+                    .collect();
+                if self.islands.settings.placement == Placement::Together && !handles.is_empty() {
+                    handles.push(Handle::Group);
+                }
+                if !handles.is_empty() {
+                    let at = handles.iter().position(|h| *h == handle).unwrap_or(0);
+                    let next = if key == 0xfe20 {
+                        (at + handles.len() - 1) % handles.len()
+                    } else {
+                        (at + 1) % handles.len()
+                    };
+                    self.islands.lease.as_mut().unwrap().selected = handles[next];
+                }
+                self.bump_island_revision();
+            },
+            0xff50 | 0xff57 | 0xff51 | 0xff52 | 0xff53 | 0xff54 => {
+                let span = match handle {
+                    Handle::Group => Some(self.islands.geometry.group),
+                    Handle::Island(s) => self.islands.geometry.spans[s.index()],
+                };
+                if let Some(span) = span {
+                    let forward = matches!(key, 0xff53 | 0xff54 | 0xff57);
+                    if self.islands.settings.placement == Placement::Together
+                        && let Handle::Island(s) = handle
+                    {
+                        let present = self.islands.geometry.spans.map(|s| s.is_some());
+                        let steps = if key == 0xff50 {
+                            -3
+                        } else if key == 0xff57 {
+                            3
+                        } else if forward {
+                            1
+                        } else {
+                            -1
+                        };
+                        self.islands.settings.layout_mut(&output).reorder_visible(
+                            Placement::Together,
+                            s,
+                            present,
+                            steps,
+                        );
+                    } else {
+                        let wanted = if key == 0xff50 {
+                            self.islands.geometry.bounds.start
+                        } else if key == 0xff57 {
+                            self.islands.geometry.bounds.end() - span.length
+                        } else {
+                            span.start + if forward { 8. } else { -8. }
+                        };
+                        dock_islands_core::move_handle(
+                            &mut self.islands.settings,
+                            &output,
+                            &self.islands.geometry,
+                            handle,
+                            wanted,
+                            false,
+                        );
+                    }
+                    self.bump_island_revision();
+                }
+            },
+            _ => return false,
+        }
+        true
+    }
+}

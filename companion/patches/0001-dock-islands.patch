+/// Keep a named-output island panel visible on a temporary fallback. The
+/// configured target and every saved monitor layout stay unchanged on disk.
+pub fn reconcile_outputs(state: &mut crate::xdg_shell_wrapper::shared_state::GlobalState) {
+    use cosmic_panel_config::CosmicPanelOuput;
+    let entries = state.space.config.config_list.clone();
+    for original in entries {
+        let CosmicPanelOuput::Name(ref wanted) = original.output else {
+            continue;
+        };
+        let enabled = load_settings(&original.name).is_ok_and(|s| s.enabled);
+        let target = state
+            .space
+            .outputs
+            .iter()
+            .find(|o| o.1.name() == *wanted)
+            .or_else(|| {
+                enabled
+                    .then(|| {
+                        state
+                            .space
+                            .outputs
+                            .iter()
+                            .min_by_key(|o| dock_islands_core::output_order(&o.1.name()))
+                    })
+                    .flatten()
+            })
+            .map(|o| o.1.name());
+        let Some(target) = target else {
+            // Standard mode on an absent named display has no surface. Retire
+            // any temporary Islands fallback, including after Undo/recovery.
+            state.space.space_list.retain(|p| p.config.name != original.name);
+            continue;
+        };
+        state.space.space_list.retain(|p| {
+            p.config.name != original.name
+                || p.output.as_ref().is_some_and(|o| o.1.name() == target)
+        });
+        if state.space.space_list.iter().any(|p| {
+            p.config.name == original.name
+                && p.output.as_ref().is_some_and(|o| o.1.name() == target)
+        }) {
+            continue;
+        }
+        let mut temporary = original.clone();
+        temporary.output = CosmicPanelOuput::Name(target);
+        state.space.update_space(
+            temporary,
+            &state.client_state.compositor_state,
+            state.client_state.fractional_scaling_manager.as_ref(),
+            state.client_state.viewporter_state.as_ref(),
+            &mut state.client_state.layer_state,
+            &state.client_state.queue_handle,
+            None,
+            state.client_state.overlap_notify.clone(),
+        );
+        if let Some(saved) =
+            state.space.config.config_list.iter_mut().find(|c| c.name == original.name)
+        {
+            *saved = original;
+        }
+    }
+}
+impl PanelSpace {
+    pub fn island_touch(
+        &mut self,
+        surface: &sctk::reexports::client::protocol::wl_surface::WlSurface,
+        id: i32,
+        point: (f64, f64),
+        phase: u8,
+    ) -> bool {
+        use sctk::seat::pointer::{BTN_LEFT, PointerEvent, PointerEventKind as K};
+        if phase != 0 && self.islands.touch.as_ref().is_none_or(|t| t.0 != id) {
+            return false;
+        }
+        let kind = match phase {
+            0 => K::Press { time: 0, serial: 0, button: BTN_LEFT },
+            1 => K::Motion { time: 0 },
+            _ => K::Release { time: 0, serial: 0, button: BTN_LEFT },
+        };
+        let used =
+            self.island_pointer(&PointerEvent { surface: surface.clone(), position: point, kind });
+        if used {
+            self.islands.touch = if phase == 2 { None } else { Some((id, point)) };
+        }
+        used
+    }
+    pub fn island_touch_up(&mut self, id: i32) -> bool {
+        let Some((active, point)) = self.islands.touch else {
+            return false;
+        };
+        if active != id {
+            return false;
+        }
+        let Some(surface) = self.layer.as_ref().map(|l| l.wl_surface().clone()) else {
+            return false;
+        };
+        self.island_touch(&surface, id, point, 2)
+    }
+}
+
+// A separate, optional record. Old companions ignore it and retain v1 layout support.
+fn load_material(panel: &str) -> Option<dock_islands_core::material::Finish> {
+    let layout = settings_path(panel).ok()?;
+    let root = layout.parent()?.parent()?.parent()?;
+    let data =
+        fs::read(root.join(dock_islands_core::material::NAMESPACE).join("v1").join(panel)).ok()?;
+    if data.len() > 4096 {
+        return None;
+    }
+    let record: dock_islands_core::material::BarMaterial = ron::de::from_bytes(&data).ok()?;
+    record.validate().ok()?;
+    Some(record.finish)
+}
+impl PanelSpace {
+    pub(crate) fn material_blur(&self) -> bool {
+        // Native backdrop enhancement is deferred; finish and native color
+        // preferences still determine the decorative background.
+        false
+    }
+}

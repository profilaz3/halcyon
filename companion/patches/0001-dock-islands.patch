+// A malformed optional applet must not terminate the entire panel host.
+fn applet_command(command: &str) -> Option<(String, Vec<String>)> {
+    let mut words = Shlex::new(command);
+    let executable = words.next()?;
+    let args: Vec<_> = words.by_ref().collect();
+    (!words.had_error && !executable.is_empty()).then_some((executable, args))

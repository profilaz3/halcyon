@@ -0,0 +1,37 @@
+//! A bounded launcher preflight (the parent enforces the timeout). Loading this
+//! executable also verifies its dynamic libraries. No panel, surface or applet.
+use sctk::reexports::client::{
+    Connection, Dispatch, QueueHandle,
+    globals::{registry_queue_init, GlobalListContents},
+    protocol::wl_registry,
+};
+
+struct Probe;
+impl Dispatch<wl_registry::WlRegistry, GlobalListContents> for Probe {
+    fn event(_: &mut Self, _: &wl_registry::WlRegistry, _: wl_registry::Event,
+             _: &GlobalListContents, _: &Connection, _: &QueueHandle<Self>) {}
+}
+
+pub fn run() -> anyhow::Result<()> {
+    // The selector strips WAYLAND_SOCKET; also refuse direct callers which
+    // could otherwise consume the panel's inherited connection by accident.
+    anyhow::ensure!(std::env::var_os("WAYLAND_SOCKET").is_none(), "use a named display");
+    let connection = Connection::connect_to_env()?;
+    let (globals, _) = registry_queue_init::<Probe>(&connection)?;
+    let advertised = globals.contents().clone_list();
+    let required = [
+        ("wl_compositor", 4), ("wl_subcompositor", 1), ("wl_shm", 1),
+        ("wl_seat", 1), ("wl_output", 1), ("xdg_wm_base", 1),
+        ("zwlr_layer_shell_v1", 1), ("wl_data_device_manager", 1),
+    ];
+    let missing: Vec<_> = required.iter().filter(|(name, version)| {
+        !advertised.iter().any(|g| g.interface == *name && g.version >= *version)
+    }).map(|(name, _)| *name).collect();
+    println!("{}", serde_json::json!({
+        "probe": 1, "ready": missing.is_empty(), "missing": missing,
+        "globals": advertised.iter().map(|g| (&g.interface, g.version))
+            .collect::<std::collections::BTreeMap<_,_>>()
+    }));
+    anyhow::ensure!(missing.is_empty(), "missing required panel globals");
+    Ok(())
+}

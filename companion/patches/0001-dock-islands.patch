+#[cfg(test)]
+mod restart_tests {
+    use super::*;
+
+    #[test]
+    fn duplicate_applet_second_occurrence_restarts_twice_in_place() {
+        let display = wayland_server::Display::<GlobalState>::new().unwrap();
+        let mut handle = display.handle();
+        let (first, first_socket) = get_client_sock(&mut handle);
+        let (second, second_socket) = get_client_sock(&mut handle);
+        let first_id = first.id();
+        let mut current = second.id();
+        let mut section = vec![
+            PanelClient::new("same.applet".into(), None, first, Some(first_socket)),
+            PanelClient::new("same.applet".into(), None, second, Some(second_socket)),
+        ];
+        // Keep the client-side sockets alive like launch-pad's inherited FDs.
+        let mut sockets = Vec::new();
+        for _ in 0..2 {
+            let old = current.clone();
+            let (replacement, socket) = get_client_sock(&mut handle);
+            let next = replacement.id();
+            sockets.push(socket);
+            assert_eq!(
+                replace_restarted_client(&mut section, &mut current, replacement, None),
+                Some(old)
+            );
+            assert_eq!(section.len(), 2);
+            assert_eq!(section[0].client.as_ref().unwrap().id(), first_id);
+            assert_eq!(section[1].client.as_ref().unwrap().id(), next);
+            assert_eq!(current, next);
+        }
+        // A callback from a removed occurrence must not claim its namesake.
+        section.remove(1);
+        let (replacement, socket) = get_client_sock(&mut handle);
+        sockets.push(socket);
+        assert!(replace_restarted_client(&mut section, &mut current, replacement, None).is_none());
+        assert_eq!(section[0].client.as_ref().unwrap().id(), first_id);
+    }
+}

[Desktop Entry]
Type=Application
Name=Activity island (beta)
Comment=Notifications, music, meetings and system activity in one expandable panel capsule
Exec=halcyon --activity-island
Icon=io.github.profilaz3.Halcyon
Terminal=false
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=None
# The panel shares the notification daemon's applet connection.
X-NotificationsApplet=true

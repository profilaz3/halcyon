#!/usr/bin/python3
"""Enable or restore the optional Islands panel for this user."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys

sys.dont_write_bytecode = True
PACKAGE = 'cosmic-ext-halcyon-islands'
LIBRARY = Path(__file__).resolve().parent.parent / 'lib' / PACKAGE
DATA = Path('.local/share/cosmic-desktop-cards')


def read_json(path):
    value = json.loads(path.read_text())
    if not isinstance(value, dict):
        raise ValueError(f'Invalid record: {path}')
    return value


def records(home, installer):
    from journal import scan, ordered
    result = []
    for path, record in scan(home):
        if record.get('owner') in (PACKAGE, 'cosmic-ext-halcyon') and not record.get('restored'):
            if record.get('root') != str(home):
                raise ValueError(f'Install record belongs to another home: {path}')
            result.append((path, record))
    return ordered(home, result)


def run_installer(arguments, env):
    result = subprocess.run([sys.executable, '-B', str(LIBRARY / 'install.py'), *arguments],
                            env=env, text=True, capture_output=True)
    if result.returncode:
        # Installer errors can contain a traceback. Keep the actionable last line.
        message = (result.stderr or result.stdout).strip().splitlines()
        raise ValueError(message[-1] if message else 'Companion installer failed')


def version_details(versions, launcher):
    lines = ['Installed COSMIC packages:']
    lines.extend(f'  {name}: {versions.get(name) or "unavailable"}' for name in launcher.PACKAGES)
    for index, system in enumerate(launcher.SUPPORTED_SYSTEMS, 1):
        lines.append(f'Supported combination {index}:')
        lines.extend(f'  {name}: {version}' for name, version in system.items())
    return '\n'.join(lines)


def status(home, launcher, installer):
    installed = all((LIBRARY / name).is_file() for name in (
        'cosmic-panel-islands', 'companion-manifest.json', 'install.py', 'panel_launcher.py'))
    versions = launcher.installed_versions()
    match = installed and launcher.compatible(LIBRARY, versions, 'companion-manifest.json')
    data = Path(os.environ.get('XDG_DATA_HOME', home / '.local/share'))
    bundle = data / 'cosmic-desktop-cards/companion'
    try:
        selection = read_json(bundle / 'selection.json')
    except (OSError, ValueError):
        selection = {}
    selector = home / '.local/bin/cosmic-panel'
    known_selectors = {launcher.digest(LIBRARY / 'panel_launcher.py')}
    active = records(home, installer)
    if active:
        known_selectors.add(active[0][1]['installed']['.local/bin/cosmic-panel'])
    selected = (selector.is_file() and launcher.digest(selector) in known_selectors
                and selection.get('enabled') is True)
    state = launcher.state_directory(home)
    failed = (state / 'failed').exists()
    ready = selected and launcher.compatible(bundle, versions) and not failed
    print('Installed: ' + ('yes' if installed else 'no'))
    print('System compatibility (selector checks): ' + ('match' if match else 'no match'))
    if not launcher.supported_system(versions):
        print(version_details(versions, launcher))
    if match:
        exact = any(versions == row for row in launcher.SUPPORTED_SYSTEMS)
        print('Qualification: ' + ('listed package combination' if exact else
              'reviewed source combination; distribution rebuild, not a fully tested OS'))
        print('Runtime ABI and compositor checks run at panel startup; status does not verify them.')
    print('Enabled for this user: ' + ('yes' if selected else 'no'))
    if failed:
        print('Stock panel selected: a previous Islands failure is recorded.')
    elif selected and not ready:
        print('Stock panel selected: the user bundle or COSMIC versions do not match.')
    elif ready:
        current = launcher.session_identity()
        if selection.get('defer_session') is not None and (
                current is None or current == selection['defer_session']):
            print('Activation: waiting for the next login.')
        else:
            print('Activation: eligible in this login; running processes are not inspected.')
    else:
        print('Activation: disabled.')
    return 0 if installed and match and ready else 1


def change(command, home, fixture, launcher, installer):
    env = {**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'}
    # The installer deliberately uses its historical home-relative layout.
    # Refuse an XDG data override that would make the selector read elsewhere.
    if command == 'enable' and Path(env.get('XDG_DATA_HOME', home / '.local/share')) != home / '.local/share':
        raise ValueError('XDG_DATA_HOME must be ~/.local/share for the companion selector')
    lockpath = installer.safe_path(home, str(DATA / 'backups/.islands.lock'))
    lockpath.parent.mkdir(parents=True, exist_ok=True)
    with os.fdopen(os.open(lockpath, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600), 'w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError('Another halcyon-islands command is running') from None
        active = records(home, installer)
        if command == 'disable':
            for path, _ in active:
                run_installer(['--restore', str(path)], env)
            if not active and (home / '.local/bin/cosmic-panel').exists():
                raise ValueError('An existing panel selector is not managed by this command; restore its original install record')
            print('Islands disabled. Log out and back in to use the stock panel.')
            return 0
        if active and not active[0][1].get('complete'):
            raise ValueError('An interrupted install exists. Run halcyon-islands disable before enabling again')
        if not active and os.path.lexists(home / '.local/bin/cosmic-panel'):
            raise ValueError('An existing panel selector is not managed by this command; restore its original install record first')
        if not launcher.compatible(LIBRARY, launcher.PACKAGES, 'companion-manifest.json'):
            raise ValueError('Packaged binary or manifest fails the selector integrity checks')
        versions = launcher.installed_versions()
        if not launcher.compatible(LIBRARY, versions, 'companion-manifest.json'):
            raise ValueError(
                'This Islands build does not support the installed COSMIC packages.\n'
                + version_details(versions, launcher)
                + '\nActivation was not changed. Install an Islands build tested for these packages; '
                  'do not downgrade COSMIC to enable it.')
        state = launcher.state_directory(home)
        if (state / 'failed').exists():
            raise ValueError(
                'A previous Islands failure selects the stock panel. Activation was not changed. '
                'See /usr/share/doc/cosmic-ext-halcyon-islands/README before retrying.')
        # Never hide edits by layering a fresh installation over a changed bundle.
        if active:
            record = active[0][1]
            for relative, expected in record['installed'].items():
                path = installer.safe_path(home, relative)
                if (not path.is_file() or launcher.digest(path) != expected
                        or path.stat().st_mode & 0o777 != record['modes'][relative]):
                    raise ValueError(f'A companion file changed since installation: {relative}')
            bundle = home / DATA / 'companion'
            same = all((bundle / dest).read_bytes() == (LIBRARY / source).read_bytes()
                       for source, dest in [('cosmic-panel-islands', 'cosmic-panel-islands'),
                                            ('companion-manifest.json', 'manifest.json')])
            same = same and (home / '.local/bin/cosmic-panel').read_bytes() == (LIBRARY / 'panel_launcher.py').read_bytes()
        else:
            same = False
        if not same:
            target = ['--root', str(home)] if fixture else ['--user']
            run_installer([*target, '--binary', str(LIBRARY / 'cosmic-panel-islands'),
                           '--manifest', str(LIBRARY / 'companion-manifest.json'),
                           '--enable-next-login', '--record-owner', PACKAGE], env)
        print('Islands enabled for the next login. Log out and back in to start it.')
        print('The normal panel is used if source qualification or runtime checks fail.')
        return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog='Run as your desktop user, without sudo.')
    parser.add_argument('--root', type=Path, help=argparse.SUPPRESS)
    parser.add_argument('--json', action='store_true', help='Versioned installation capability (status only)')
    parser.add_argument('command', choices=['status', 'diagnostics', 'refresh', 'enable', 'disable'])
    args = parser.parse_args()
    home = (args.root or Path.home()).resolve()
    if args.root:
        # Fixture mode keeps even inherited XDG paths inside the fixture.
        os.environ.update(HOME=str(home), XDG_DATA_HOME=str(home / '.local/share'),
                          XDG_STATE_HOME=str(home / '.local/state'), XDG_CONFIG_HOME=str(home / '.config'))
    if args.command in ('status', 'diagnostics') and (args.json or args.command == 'diagnostics'):
        helper = LIBRARY / 'install_status.py'
        if not helper.is_file():
            helper = Path('/usr/lib/cosmic-ext-halcyon/islands-status.py')
        if not helper.is_file():
            print(json.dumps(dict(format='halcyon-islands-installation', version=1,
                                  installation='absent', provenance=None, enabled=False,
                                  compatible=None, running=None, healthy=None)))
            return 0
        command = [sys.executable, '-B', str(helper)]
        if args.root:
            command += ['--root', str(home), '--library', str(LIBRARY)]
        return subprocess.run(command, timeout=8, check=False).returncode
    if not (LIBRARY / 'panel_launcher.py').is_file() or not (LIBRARY / 'install.py').is_file():
        print('Islands is incomplete. Install or reinstall the Halcyon package.', file=sys.stderr)
        return 1
    sys.path.insert(0, str(LIBRARY))
    import panel_launcher as launcher
    import install as installer
    try:
        if args.command == 'refresh':
            import refresh
            print(json.dumps(refresh.stage_installed_update(home, LIBRARY, fixture=args.root is not None)))
            return 0
        import install_status
        try:
            modern = read_json(LIBRARY / 'companion-manifest.json').get('version') == 2
        except (OSError, ValueError):
            modern = False
        if modern and args.command == 'status':
            return subprocess.run([sys.executable, '-B', str(LIBRARY / 'install_status.py'),
                *(['--root', str(home), '--library', str(LIBRARY)] if args.root else [])], timeout=8).returncode
        if modern and args.command == 'enable':
            import refresh
            if args.root is None:
                refresh.require_selector_path(home)
            with refresh.locked(home):
                if (launcher.state_directory(home) / 'failed').exists():
                    raise ValueError('A previous Islands failure selects the stock panel. Activation was not changed.')
                result = refresh.stage_locked(home, LIBRARY, fixture=args.root is not None, enable=True)
            print(json.dumps(result))
            return 0 if result['state'] in ('staged', 'unchanged') else 1
        if args.command == 'status':
            return status(home, launcher, installer)
        return change(args.command, home, args.root is not None, launcher, installer)
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(f'Islands: {error}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
